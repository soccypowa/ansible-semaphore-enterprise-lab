# Copy to .env and fill in real values. Never commit the filled-in .env --
# it's already in .gitignore.

SEMAPHORE_DB_USER=semaphore
SEMAPHORE_DB_PASS=changeme-use-a-long-random-string
SEMAPHORE_DB_NAME=semaphore

SEMAPHORE_ADMIN_USER=admin
SEMAPHORE_ADMIN_PASS=changeme-use-a-long-random-string
SEMAPHORE_ADMIN_NAME="Semaphore Admin"
SEMAPHORE_ADMIN_EMAIL=admin@example.com

# Generate each of these independently with: openssl rand -base64 32
SEMAPHORE_COOKIE_HASH=
SEMAPHORE_COOKIE_ENCRYPTION=
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
